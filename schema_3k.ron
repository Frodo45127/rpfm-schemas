    patches: {
        "_kv_battle_ai_ability_usage_variables_tables": {
            "key": {
                "lookup_hardcoded": "mana_saving_max_added_amount;;;;;UNARY: when we want to save mana, what is the max for the pool of magic to increase to (i.e. 0.4 we wait for another 0%-40% to be added):::::mana_saving_threshold;;;;;UNARY: when do we add a threshold for using the next man costing abilities:::::min_score_for_activation;;;;;What score do we need at a minimum for the AI to use abilities",
            },
        },
